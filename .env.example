# Client (Vite)
# Optional. Only needed when the API is hosted on a different origin than the
# frontend (for example a separate Vercel project). Leave it empty to use the
# same-origin /api/* paths (local dev proxy and same-project serverless functions).
# VITE_API_BASE_URL=https://your-api-origin.vercel.app

# Server
# NODE_ENV is set by the npm scripts. Do not set it here: Vite reads it during builds.
PORT=8787

# Comma-separated browser origins allowed to call the API.
# Use * only for local experiments; never in production.
ALLOWED_ORIGINS=http://localhost:5173

# AI provider (OpenAI-compatible chat completions API).
# Leave AI_API_KEY empty to run in clearly labeled synthetic demo mode.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional second model, used only if the primary model fails with a
# retryable upstream error (rate limit or provider outage). Leave empty to disable.
AI_FALLBACK_MODEL=

# Optional OpenRouter attribution headers.
AI_SITE_URL=
AI_APP_NAME=CardioBridge AI

# Enable provider reasoning when supported (e.g. OpenRouter reasoning models).
AI_REASONING_ENABLED=false

# Reasoning effort for providers that use it (Groq, OpenAI-style APIs):
# low | medium | high. When set, it replaces AI_REASONING_ENABLED, because
# those providers reject the OpenRouter `reasoning: { enabled: true }` object.
AI_REASONING_EFFORT=

# Maximum completion tokens per AI request, including reasoning tokens.
# Must be an integer between 2000 and 32000. Reasoning models need a high ceiling.
AI_MAX_TOKENS=12000

# Timeout for a single AI request, in milliseconds. Must be an integer between
# 1000 and 600000. Use a lower value on serverless platforms where the
# function is killed before the provider answers (Vercel: AI_REQUEST_TIMEOUT_MS=50000).
AI_REQUEST_TIMEOUT_MS=180000

# Per-IP request limits for each 15-minute window.
ANALYZE_RATE_LIMIT=30
