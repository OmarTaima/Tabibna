{
  "name": "cardiobridge",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "CardioBridge — bilingual medical language, follow-up assessment, and echocardiography interpretation.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/src/index.ts",
    "build": "npm run typecheck && npm run typecheck:server && vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "test:server": "tsx server/tests/smoke.ts && tsx server/tests/failure-paths.ts && tsx server/tests/prompt.ts && tsx server/tests/live-ai.ts",
    "test:client": "tsx src/lib/reminders.test.ts && tsx src/lib/notifications.test.ts && tsx src/lib/ocr-text.test.ts",
    "test": "npm run test:server && npm run test:client",
    "start": "cross-env NODE_ENV=production tsx server/src/index.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "tailwind-merge": "^2.6.0",
    "tesseract.js": "^7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.5",
    "cross-env": "^7.0.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vite": "^7.1.3"
  }
}
